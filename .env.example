# Copier ce fichier vers .env puis renseigner les valeurs du projet Supabase
# (Dashboard Supabase → Project Settings → API Keys).
# Variables EXPO_PUBLIC_ visibles en clair dans l'APK : jamais de clé secrète (service_role / sb_secret_…).

# URL du projet, ex. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ID du client OAuth Google de type « Application Web » (pas le client Android)
# (Google Cloud → API et services → Identifiants), ex. 123-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# DSN du projet Sentry hijra-projects/budget (Project Settings → Client Keys (DSN)). Public.
EXPO_PUBLIC_SENTRY_DSN=
# Token d'organisation Sentry (Settings → Developer Settings → Organization Tokens).
# Secret : sans préfixe EXPO_PUBLIC_, utilisé uniquement au build release pour envoyer les source maps.
SENTRY_AUTH_TOKEN=
