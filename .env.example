# Copier ce fichier vers .env puis renseigner les valeurs du projet Supabase
# (Dashboard Supabase → Project Settings → API Keys).
# Variables EXPO_PUBLIC_ visibles en clair dans l'APK : jamais de clé secrète (service_role / sb_secret_…).

# URL du projet, ex. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
