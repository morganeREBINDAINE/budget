{
  "expo": {
    "name": "Budget",
    "slug": "budget",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budget",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mrebi.budget"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "hijra-projects",
          "project": "budget"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da3806c0-b77a-4511-82bf-7591e004f9ee"
      }
    },
    "owner": "mrebindaine",
    "updates": {
      "url": "https://u.expo.dev/da3806c0-b77a-4511-82bf-7591e004f9ee"
    }
  }
}
